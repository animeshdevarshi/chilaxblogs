---
// A row of phone screenshots with captions, for step-by-step guides in MDX posts.
// Usage: <PhoneShots shots={[{ src: img, alt: '…', caption: '…' }]} />
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	shots: { src: ImageMetadata; alt: string; caption?: string }[];
}

const { shots } = Astro.props;
---

<div class="phone-shots">
	{
		shots.map(({ src, alt, caption }) => (
			<figure>
				<Image src={src} alt={alt} width={440} />
				{caption && <figcaption>{caption}</figcaption>}
			</figure>
		))
	}
</div>

<style>
	.phone-shots {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1.25em;
		margin: 1.5em 0 2em;
	}
	figure {
		flex: 0 1 220px;
		margin: 0;
		text-align: center;
	}
	img {
		width: 100%;
		height: auto;
		border-radius: 22px;
		border: 1px solid rgb(var(--gray-light));
		box-shadow: var(--box-shadow);
	}
	figcaption {
		margin-top: 0.6em;
		font-size: 0.85em;
		line-height: 1.4;
		color: rgb(var(--gray));
	}
</style>
